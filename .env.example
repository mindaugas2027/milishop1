# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Supabase hosted PostgreSQL connection string for production.
# DATABASE_URL=

# Supabase Auth project settings (server-side only).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # only needed for one-time admin creation; keep private
# SUPABASE_ADMIN_PASSWORD=    # only needed for one-time admin creation; use a strong password
